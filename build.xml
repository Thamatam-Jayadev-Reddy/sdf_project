<project name="ArbitraryArithmetic" default="compile" basedir=".">

    <property name="src1.dir" value="."/>
    <property name="src2.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="jar.file" value="${build.dir}/arithmetic.jar"/>

    <target name="init">
        <mkdir dir="${build.dir}"/>
    </target>

    <target name="compile" depends="init">
        
        <javac destdir="${build.dir}">
            <src path="${src1.dir}"/>
            <src path="${src2.dir}"/>
        </javac>
        
        
        <jar destfile="${jar.file}" basedir="${build.dir}">
            <fileset dir="${build.dir}">
                <include name="/*.class"/>
            </fileset>
        </jar>
    </target>

    

</project>